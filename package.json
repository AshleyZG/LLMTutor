{
  "name": "llmtutor",
  "displayName": "LLMTutor",
  "description": "This is a virtual tutor for students, which could provide both proactive and reactive feedback.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "LLMTutor Settings",
      "properties": {
        "llmtutor.exportUrl": {
          "type": "string",
          "default": "http://ec2-3-136-84-234.us-east-2.compute.amazonaws.com:5001/",
          "description": "The URL to export data to backend."
        },
        "telemetry.activeEvents": {
          "type": "array",
          "default": [
            {
              "name": "DocumentOpenEvent",
              "logWholeDocument": true
            },
            {
              "name": "DocumentChangeEvent",
              "logWholeDocument": false
            },
            {
              "name": "DocumentCloseEvent",
              "logWholeDocument": false
            },
            {
              "name": "DocumentSaveEvent",
              "logWholeDocument": false
            }
          ],
          "description": "Active events settings"
        },
        "telemetry.exporters": {
          "type": "array",
          "default": [
            {
              "type": "console_exporter"
            },
            {
              "type": "remote_exporter",
              "args": {
                "id": "InfluxDB",
                "url": "https://68ltdi5iij.execute-api.us-east-1.amazonaws.com/influx-vscode",
                "params": {
                  "influx_bucket": "telemetry_dev",
                  "influx_measurement": "vscode"
                }
              },
              "activeEvents": [
                {
                  "name": "DocumentOpenEvent",
                  "logWholeDocument": true
                },
                {
                  "name": "DocumentChangeEvent",
                  "logWholeDocument": false
                }
              ]
            }
          ],
          "description": "Exporter settings"
        }
      }
    },
    "commands": [
      {
        "command": "llmtutor.proactiveMode",
        "title": "Proactive Mode",
        "icon": "$(comment)"
      },
      {
        "command": "llmtutor.promptQuestion",
        "title": "Prompt Question"
      },
      {
        "command": "extension.showQuestions",
        "title": "Show Questions"
      },
      {
        "command": "llmtutor.toggleActivation",
        "title": "Toggle Activation"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "llmtutor.proactiveMode",
          "group": "navigation"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "chat-tutorial.code-tutor",
        "fullName": "Code Tutor",
        "name": "tutor",
        "description": "What can I teach you?",
        "isSticky": true,
        "commands": [
          {
            "name": "start",
            "description": "Start the conversation"
          },
          {
            "name": "end",
            "description": "End the conversation"
          }
        ]
      },
      {
        "id": "chat-tutorial.human-instructor",
        "fullName": "Human Instructor",
        "name": "instructor",
        "description": "Human instructor that manage the tutor",
        "commands": [
          {
            "name": "read",
            "description": "Read the current message from human"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "prettier": "3.0.3",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.1"
  }
}
